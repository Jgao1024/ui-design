{
  "num": 5,
  "slug": "textedit",
  "app": "文本编辑",
  "bundle": "com.apple.TextEdit",
  "batch": 2,
  "pre_actions": [
    {
      "key": "cmd+n"
    },
    {
      "wait": 0.5
    },
    {
      "type": "设计系统组件清单\n按钮 / 侧栏 / 卡片"
    }
  ],
  "steps": [
    {
      "name": "01-main",
      "op": "主窗口默认态",
      "actions": [
        {
          "wait": 0.4
        }
      ]
    },
    {
      "name": "02-plain",
      "op": "纯文本模式",
      "actions": [
        {
          "key": "cmd+shift+t"
        },
        {
          "wait": 1.0
        }
      ]
    },
    {
      "name": "03-search",
      "op": "查找",
      "actions": [
        {
          "key": "cmd+f"
        },
        {
          "wait": 0.5
        },
        {
          "type": "abc"
        },
        {
          "wait": 0.9
        }
      ]
    },
    {
      "name": "04-prefs",
      "op": "偏好设置",
      "actions": [
        {
          "key": "cmd+,"
        },
        {
          "wait": 1.4
        }
      ],
      "cleanup": [
        {
          "key": "cmd+w"
        },
        {
          "wait": 0.5
        }
      ]
    }
  ]
}