{
  "num": 2,
  "slug": "finder",
  "app": "访达",
  "bundle": "com.apple.finder",
  "batch": 1,
  "open_args": [
    "/Users/jgao/Git/ui-design/macos-shots/assets/demo"
  ],
  "settle": 2.6,
  "steps": [
    {
      "name": "01-main",
      "op": "主窗口默认态",
      "actions": [
        {
          "wait": 0.4
        }
      ]
    },
    {
      "name": "02-list",
      "op": "列表视图",
      "actions": [
        {
          "key": "cmd+2"
        },
        {
          "wait": 1.0
        }
      ]
    },
    {
      "name": "03-column",
      "op": "分栏视图",
      "actions": [
        {
          "key": "cmd+3"
        },
        {
          "wait": 1.0
        }
      ]
    },
    {
      "name": "04-search",
      "op": "搜索态",
      "actions": [
        {
          "key": "cmd+f"
        },
        {
          "wait": 0.6
        },
        {
          "type": "ui"
        },
        {
          "wait": 1.2
        }
      ]
    },
    {
      "name": "04-prefs",
      "op": "访达设置",
      "actions": [
        {
          "key": "cmd+,"
        },
        {
          "wait": 1.4
        }
      ],
      "cleanup": [
        {
          "key": "cmd+w"
        },
        {
          "wait": 0.5
        }
      ]
    }
  ]
}