{
  "num": 10,
  "slug": "mail",
  "app": "邮件",
  "bundle": "com.apple.mail",
  "batch": 3,
  "steps": [
    {
      "name": "01-main",
      "op": "主窗口默认态",
      "actions": [
        {
          "wait": 0.4
        }
      ]
    },
    {
      "name": "02-selection",
      "op": "选中邮件",
      "actions": [
        {
          "pressfirst": [
            "AXRow,AXOutlineRow,AXCell,AXListItem",
            "边栏"
          ]
        },
        {
          "wait": 0.8
        }
      ]
    },
    {
      "name": "03-search",
      "op": "搜索邮件",
      "actions": [
        {
          "key": "cmd+f"
        },
        {
          "wait": 0.5
        },
        {
          "type": "a"
        },
        {
          "wait": 0.9
        }
      ]
    },
    {
      "name": "04-prefs",
      "op": "偏好设置",
      "actions": [
        {
          "key": "cmd+,"
        },
        {
          "wait": 1.4
        }
      ],
      "cleanup": [
        {
          "key": "cmd+w"
        },
        {
          "wait": 0.5
        }
      ]
    }
  ]
}