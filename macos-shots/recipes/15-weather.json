{
  "num": 15,
  "slug": "weather",
  "app": "天气",
  "bundle": "com.apple.weather",
  "batch": 3,
  "steps": [
    {
      "name": "01-main",
      "op": "主窗口默认态",
      "actions": [
        {
          "wait": 0.4
        }
      ]
    },
    {
      "name": "02-selection",
      "op": "切换城市",
      "actions": [
        {
          "pressfirst": [
            "AXRow,AXOutlineRow,AXCell,AXListItem",
            "边栏"
          ]
        },
        {
          "wait": 0.8
        }
      ]
    },
    {
      "name": "03-list",
      "op": "城市列表",
      "actions": [
        {
          "key": "cmd+2"
        },
        {
          "wait": 1.0
        }
      ]
    },
    {
      "name": "05-menu",
      "op": "菜单（显示）",
      "actions": [
        {
          "menu": "显示"
        },
        {
          "wait": 0.6
        }
      ],
      "capture": "menu",
      "cleanup": [
        {
          "esc": 1
        },
        {
          "wait": 0.3
        }
      ]
    }
  ]
}