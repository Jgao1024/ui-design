{
  "num": 21,
  "slug": "clock",
  "app": "时钟",
  "bundle": "com.apple.clock",
  "batch": 4,
  "steps": [
    {
      "name": "01-main",
      "op": "主窗口默认态",
      "actions": [
        {
          "wait": 0.4
        }
      ]
    },
    {
      "name": "02-stopwatch",
      "op": "秒表",
      "actions": [
        {
          "key": "cmd+2"
        },
        {
          "wait": 1.0
        }
      ]
    },
    {
      "name": "03-timer",
      "op": "计时器",
      "actions": [
        {
          "key": "cmd+3"
        },
        {
          "wait": 1.0
        }
      ]
    }
  ]
}