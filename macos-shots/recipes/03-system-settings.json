{
  "num": 3,
  "slug": "system-settings",
  "app": "系统设置",
  "bundle": "com.apple.systempreferences",
  "batch": 1,
  "steps": [
    {
      "name": "01-main",
      "op": "主窗口默认态",
      "actions": [
        {
          "wait": 0.4
        }
      ]
    },
    {
      "name": "02-selection",
      "op": "进入子面板",
      "actions": [
        {
          "pressfirst": [
            "AXRow,AXCell",
            "搜索"
          ]
        },
        {
          "wait": 0.8
        }
      ]
    },
    {
      "name": "03-search",
      "op": "设置内搜索",
      "actions": [
        {
          "key": "cmd+f"
        },
        {
          "wait": 0.5
        },
        {
          "type": "声音"
        },
        {
          "wait": 0.9
        }
      ]
    },
    {
      "name": "05-menu",
      "op": "菜单（显示）",
      "actions": [
        {
          "menu": "显示"
        },
        {
          "wait": 0.6
        }
      ],
      "capture": "menu",
      "cleanup": [
        {
          "esc": 1
        },
        {
          "wait": 0.3
        }
      ]
    }
  ]
}