{
  "num": 8,
  "slug": "calendar",
  "app": "日历",
  "bundle": "com.apple.iCal",
  "batch": 2,
  "steps": [
    {
      "name": "01-main",
      "op": "主窗口默认态",
      "actions": [
        {
          "wait": 0.4
        }
      ]
    },
    {
      "name": "02-week",
      "op": "周视图",
      "actions": [
        {
          "key": "cmd+2"
        },
        {
          "wait": 1.0
        }
      ]
    },
    {
      "name": "03-month",
      "op": "月视图",
      "actions": [
        {
          "key": "cmd+3"
        },
        {
          "wait": 1.0
        }
      ]
    },
    {
      "name": "04-prefs",
      "op": "偏好设置",
      "actions": [
        {
          "key": "cmd+,"
        },
        {
          "wait": 1.4
        }
      ],
      "cleanup": [
        {
          "key": "cmd+w"
        },
        {
          "wait": 0.5
        }
      ]
    }
  ]
}